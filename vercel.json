{
  "version": 2,
  "installCommand": "npx --yes pnpm@9.15.9 install --no-frozen-lockfile",
  "buildCommand": "npx --yes pnpm@9.15.9 --filter frontend build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
