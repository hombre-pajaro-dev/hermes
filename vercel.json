{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter frontend build",
  "outputDirectory": "packages/frontend/dist",
  "functions": {
    "api/index.ts": {}
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
