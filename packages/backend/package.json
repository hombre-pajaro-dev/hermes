{
  "name": "backend",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "tsx --env-file=.env src/scripts/migrate.ts",
    "seed": "tsx --env-file=.env src/scripts/seed.ts",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "test:server": "PORT=3002 NODE_ENV=test tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "NODE_ENV=test cucumber-js --config cucumber.js",
    "test:doc": "NODE_ENV=test tsx src/scripts/generate-bdd-doc.ts"
  },
  "dependencies": {
    "better-auth": "^1.5.6",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "kysely": "^0.28.14",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.7.0",
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.14",
    "@types/supertest": "^7.2.0",
    "chai": "^6.2.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
